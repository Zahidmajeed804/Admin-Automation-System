NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB connection string. Use MongoDB Atlas or a local instance.
MONGO_URI=mongodb://127.0.0.1:27017/admin_automation_system

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Attendance: worked minutes per day after which the excess is overtime (600 = 10 hours).
OVERTIME_THRESHOLD_MINUTES=600

# Maintenance invoices: where uploaded files are stored on disk (relative to
# where the backend is run from) and the largest file accepted, in megabytes.
INVOICE_UPLOAD_DIR=uploads/invoices
INVOICE_MAX_SIZE_MB=5

# Outgoing mail (maintenance reminder emails). Leave SMTP_HOST blank to run
# without sending real mail: messages are built but only logged, which is
# fine for development. Fill these in with real SMTP credentials to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Admin Automation System <no-reply@example.com>

# Maintenance reminder emails: daily job schedule (5-field cron) and an
# on/off switch so it can be disabled without removing the credentials above.
EMAIL_REMINDERS_ENABLED=true
REMINDER_CRON_SCHEDULE=0 7 * * *
